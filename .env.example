# Copy to .env. Defaults work with the docker-compose stack and a local Ollama.
DATABASE_URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings / reranker (local models, no key needed)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

JWT_SECRET=change-me

# dev | test | prod  (prod refuses a weak JWT_SECRET)
APP_ENV=dev
JWT_TTL_MINUTES=1440
