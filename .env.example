# Copy to .env. Defaults work with the docker-compose stack and a local Ollama.
DATABASE_URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# LLM provider: ollama | openai | anthropic | fake   (fake = no model needed, for first runs)
LLM_PROVIDER=ollama
# Leave empty to use the provider default (ollama llama3.1:8b, openai gpt-4o-mini, anthropic claude-sonnet-5-5)
LLM_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
# Any OpenAI-compatible server (vLLM, LM Studio, OpenRouter) works by changing this
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Embeddings: ollama | openai | fake. Empty model = provider default (ollama nomic-embed-text)
EMBED_PROVIDER=ollama
EMBED_MODEL=
RERANK_MODEL=BAAI/bge-reranker-base

# Vector store: qdrant | memory (memory is lost on restart; for demos and tests)
VECTOR_STORE=qdrant
QDRANT_API_KEY=

JWT_SECRET=change-me-generate-one-with-openssl-rand-hex-32

# dev | test | prod  (prod refuses a weak JWT_SECRET)
APP_ENV=dev
JWT_TTL_MINUTES=1440

# Logging: json (one object per line, for production) | console (readable, for development)
LOG_LEVEL=INFO
LOG_FORMAT=json
