# Copy to .env. Defaults work with the docker-compose stack and a local Ollama.
DATABASE_URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# LLM provider: ollama | openai | anthropic | fake   (fake = no model needed, for first runs)
LLM_PROVIDER=ollama
# Leave empty to use the provider default (ollama llama3.1:8b, openai gpt-4o-mini, anthropic claude-sonnet-5-5)
LLM_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
# Any OpenAI-compatible server (vLLM, LM Studio, OpenRouter) works by changing this
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Embeddings: ollama | openai | fake. Empty model = provider default (ollama nomic-embed-text)
EMBED_PROVIDER=ollama
EMBED_MODEL=
# Reranking is off by default: none | fake | llm | cohere | local
RERANK_PROVIDER=none
# RERANK_MODEL=            # empty = the provider's default (cohere: rerank-v3.5, local: BAAI/bge-reranker-base)
# RERANK_API_KEY=          # cohere / jina
# RERANK_BASE_URL=https://api.cohere.com/v2   # or https://api.jina.ai/v1

# Vector store: qdrant | memory (memory is lost on restart; for demos and tests)
VECTOR_STORE=qdrant
QDRANT_API_KEY=

JWT_SECRET=change-me-generate-one-with-openssl-rand-hex-32

# dev | test | prod  (prod refuses a weak JWT_SECRET)
APP_ENV=dev
JWT_TTL_MINUTES=1440

# Logging: json (one object per line, for production) | console (readable, for development)
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- documents and ingestion (Phase 2) ---
STORAGE_DIR=./data/blobs
MAX_UPLOAD_MB=25
# Allow URL ingestion to reach localhost/private networks (leave false in production)
ALLOW_PRIVATE_URLS=false
# Run the ingestion worker inside the API process
WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=3

# Embedding: texts per request, and the longest text sent (longer ones are truncated and counted)
EMBED_BATCH_SIZE=32
EMBED_MAX_CHARS=8000

# --- connectors (Phase 2.7) ---
# Optional: lets GitHub sources read private repositories and raises the API rate limit
GITHUB_TOKEN=
SOURCE_MAX_PER_COLLECTION=20
SOURCE_SYNC_CONCURRENCY=2

# --- retrieval and answering (Phases 3-4) ---
# Searches are saved with their trace for the Inspector; the newest N are kept per workspace (0 = off)
RETRIEVAL_HISTORY_LIMIT=500
# Below this confidence the assistant says "I couldn't find this" instead of guessing.
# Reranker and embedding scores are not calibrated across providers: tune it on your own questions.
ANSWER_ABSTAIN_BELOW=0.15
# Pin a version of the answer prompt (default: the latest, see GET /v1/prompts)
# ANSWER_PROMPT_VERSION=1
# Conversation memory: recent messages sent verbatim (count and tokens), and how many older
# messages pile up before they are folded into the rolling summary
ANSWER_HISTORY_MESSAGES=6
ANSWER_HISTORY_TOKENS=1500
ANSWER_SUMMARIZE_AFTER=4
# Long-term facts per workspace
MEMORY_MAX_FACTS=50
